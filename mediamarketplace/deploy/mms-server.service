[Unit]
Description=MediaMarketplace Studio server
After=network-online.target
Wants=network-online.target

[Service]
User=mms
Group=mms
WorkingDirectory=/var/lib/mms
Environment=MMS_CONFIG=/etc/mms/mms.toml
ExecStart=/usr/local/bin/mms-server serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mms

[Install]
WantedBy=multi-user.target
