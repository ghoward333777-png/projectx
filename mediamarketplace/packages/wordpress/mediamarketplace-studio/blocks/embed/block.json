{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mms/embed",
  "title": "MediaMarketplace Embed",
  "category": "media",
  "icon": "layout",
  "description": "Place a widget built in the MediaMarketplace widget builder, a single product page or a player.",
  "keywords": ["widget", "player", "product", "media"],
  "textdomain": "mediamarketplace-studio",
  "attributes": {
    "kind": { "type": "string", "default": "widget" },
    "id": { "type": "string", "default": "" },
    "view": { "type": "string", "default": "" }
  },
  "supports": { "html": false, "align": ["wide", "full"] },
  "editorScript": "mms-blocks-editor"
}
