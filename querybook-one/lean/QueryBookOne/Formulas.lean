/-! ### Pythagorean theorem (Geometry): c² = a² + b² -/
noncomputable def pythagoras_c (a b : ℝ) : ℝ := Real.sqrt (a ^ 2 + b ^ 2)
noncomputable def pythagoras_a (c b : ℝ) : ℝ := Real.sqrt (c ^ 2 - b ^ 2)
noncomputable def pythagoras_b (c a : ℝ) : ℝ := Real.sqrt (c ^ 2 - a ^ 2)
theorem pythagoras_a_recomputes_c (c b : ℝ)
    (h_c : 0 < c) (h_b : 0 < b) (h_lt : b < c) :
    pythagoras_c (pythagoras_a c b) b = c := by
  simp only [pythagoras_c, pythagoras_a]
  rw [Real.sq_sqrt (by nlinarith), show c ^ 2 - b ^ 2 + b ^ 2 = c ^ 2 by ring]
  exact Real.sqrt_sq h_c.le
theorem pythagoras_b_recomputes_c (c a : ℝ)
    (h_c : 0 < c) (h_a : 0 < a) (h_lt : a < c) :
    pythagoras_c a (pythagoras_b c a) = c := by
  simp only [pythagoras_c, pythagoras_b]
  rw [Real.sq_sqrt (by nlinarith), show a ^ 2 + (c ^ 2 - a ^ 2) = c ^ 2 by ring]
  exact Real.sqrt_sq h_c.le

/-! ### Snell's law (Optics): n1 · sin θ1 = n2 · sin θ2 -/
noncomputable def snell_n1 (t1 n2 t2 : ℝ) : ℝ := n2 * sind (t2) / sind (t1)
noncomputable def snell_t1 (n1 n2 t2 : ℝ) : ℝ := asind (n2 * sind (t2) / n1)
noncomputable def snell_n2 (n1 t1 t2 : ℝ) : ℝ := n1 * sind (t1) / sind (t2)
noncomputable def snell_t2 (n1 t1 n2 : ℝ) : ℝ := asind (n1 * sind (t1) / n2)
theorem snell_t1_recomputes_n1 (n1 n2 t2 : ℝ)
    (h_n1 : 0 < n1) (h_n2 : 0 < n2) (h_t2 : 0 < t2) (h_t2u : t2 < 90) (h_le : n2 * sind t2 / n1 ≤ 1) :
    snell_n1 (snell_t1 n1 n2 t2) n2 t2 = n1 := by
  simp only [snell_n1, snell_t1]
  have h2 := sind_pos t2 h_t2 (by linarith)
  rw [sind_asind _ (by linarith [show (0 : ℝ) ≤ n2 * sind t2 / n1 by positivity]) h_le]
  qb_field
theorem snell_n2_recomputes_n1 (n1 t1 t2 : ℝ)
    (h_n1 : 0 < n1) (h_t1 : 0 < t1) (h_t2 : 0 < t2) (h_t1u : t1 < 90) (h_t2u : t2 < 90) :
    snell_n1 t1 (snell_n2 n1 t1 t2) t2 = n1 := by
  simp only [snell_n1, snell_n2]
  have h1 := sind_pos t1 h_t1 (by linarith)
  have h2 := sind_pos t2 h_t2 (by linarith)
  qb_field
theorem snell_t2_recomputes_n1 (n1 t1 n2 : ℝ)
    (h_n1 : 0 < n1) (h_t1 : 0 < t1) (h_n2 : 0 < n2) (h_t1u : t1 < 90) (h_le : n1 * sind t1 / n2 ≤ 1) :
    snell_n1 t1 n2 (snell_t2 n1 t1 n2) = n1 := by
  simp only [snell_n1, snell_t2]
  have h1 := sind_pos t1 h_t1 (by linarith)
  rw [sind_asind _ (by linarith [show (0 : ℝ) ≤ n1 * sind t1 / n2 by positivity]) h_le]
  qb_field

/-! ### Compound interest (Finance): A = P · (1 + r/n)^(n·t) -/
noncomputable def interest_Amt (P rate n t : ℝ) : ℝ := P * (((1 : ℝ) + rate / n) ^ (n * t))
noncomputable def interest_P (Amt rate n t : ℝ) : ℝ := Amt / (((1 : ℝ) + rate / n) ^ (n * t))
noncomputable def interest_t (Amt P rate n : ℝ) : ℝ := Real.log (Amt / P) / (n * Real.log ((1 : ℝ) + rate / n))
theorem interest_P_recomputes_Amt (Amt rate n t : ℝ)
    (h_Amt : 0 < Amt) (h_rate : 0 < rate) (h_n : 0 < n) (h_t : 0 < t) :
    interest_Amt (interest_P Amt rate n t) rate n t = Amt := by
  simp only [interest_Amt, interest_P]
  have hb : 0 < (1 : ℝ) + rate / n := by positivity
  have hp := (Real.rpow_pos_of_pos hb (n * t)).ne'
  qb_field
theorem interest_t_recomputes_Amt (Amt P rate n : ℝ)
    (h_Amt : 0 < Amt) (h_P : 0 < P) (h_rate : 0 < rate) (h_n : 0 < n) :
    interest_Amt P rate n (interest_t Amt P rate n) = Amt := by
  simp only [interest_Amt, interest_t]
  have hb : 1 < (1 : ℝ) + rate / n := by linarith [show (0 : ℝ) < rate / n by positivity]
  have hl := (Real.log_pos hb).ne'
  have hn := h_n.ne'
  rw [Real.rpow_def_of_pos (by linarith),
      show Real.log (1 + rate / n) * (n * (Real.log (Amt / P) / (n * Real.log (1 + rate / n)))) = Real.log (Amt / P) by
        qb_field,
      Real.exp_log (by positivity)]
  qb_field

