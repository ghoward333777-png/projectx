noncomputable def pendulum_L (T g : ℝ) : ℝ := g * ((T / ((2 : ℝ) * Real.pi)) ^ 2)
noncomputable def pendulum_g (T L : ℝ) : ℝ := L * (((2 : ℝ) * Real.pi / T) ^ 2)
theorem pendulum_L_recomputes_T (T g : ℝ)
    (h_T : 0 < T) (h_g : 0 < g) :
    pendulum_T (pendulum_L T g) g = T := by
  simp only [pendulum_T, pendulum_L]
  have hpi := Real.pi_pos
  rw [mul_div_cancel_left₀ _ h_g.ne', Real.sqrt_sq (by positivity)]
  qb_field
theorem pendulum_g_recomputes_T (T L : ℝ)
    (h_T : 0 < T) (h_L : 0 < L) :
    pendulum_T L (pendulum_g T L) = T := by
  simp only [pendulum_T, pendulum_g]
  have hpi := Real.pi_pos
  rw [show L / (L * (2 * Real.pi / T) ^ 2) = (T / (2 * Real.pi)) ^ 2 by qb_field, Real.sqrt_sq (by positivity)]
  qb_field

